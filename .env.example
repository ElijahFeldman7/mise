# mise — Supabase project "mise" (us-east-1)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Where the app actually lives, for canonical URLs and link previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google OAuth (direct sign-in flow). Redirect URI: {site origin}/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_SECRET=your-client-secret

# Only needed by `npm run seed`, never by the running app.
# Supabase -> Settings -> API Keys -> Secret keys
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
